{
  "openapi": "3.1.0",
  "info": {
    "title": "Nevis Search API",
    "description": "Search client names, emails and descriptions, and document contents. Document retrieval combines text matching with local semantic embeddings. For protected deployments, enter the X-API-Key using Authorize.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/clients": {
      "post": {
        "tags": [
