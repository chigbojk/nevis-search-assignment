# Local SQLite setup; Docker Compose supplies its own Postgres URL.
DATABASE_URL=sqlite:///./data/search.db
MODEL_PATH=assets/model
SEMANTIC_THRESHOLD=0.60
# Authentication is optional locally. For hosting, generate a key and enable it.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
REQUIRE_API_KEY=false
